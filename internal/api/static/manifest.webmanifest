{
  "name": "notiphy",
  "short_name": "notiphy",
  "description": "Self-hosted webhooks to phone notifications",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1013",
  "theme_color": "#2f6df6",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
